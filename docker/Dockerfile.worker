# 定时任务容器。
#
# Next.js 是请求驱动模型，跑不了常驻 cron，所以 worker 必须是独立进程。
# 它只做与业务应用无关的事（待办扫描、提醒派发、通知重试）；业务应用自己的
# 定时任务由 worker 通过内部接口叫醒（见 services/worker/src/jobs.ts）。

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

FROM base AS deps
COPY package.json package-lock.json ./
COPY packages/db/package.json packages/db/
COPY packages/core/package.json packages/core/
COPY packages/auth/package.json packages/auth/
COPY packages/todo/package.json packages/todo/
COPY packages/notify/package.json packages/notify/
COPY packages/ui/package.json packages/ui/
COPY services/worker/package.json services/worker/
RUN npm ci

FROM deps AS runner
# Prisma 的查询引擎不在 npm 包里，prisma generate 要从 binaries.prisma.sh 下载
# 与当前平台匹配的二进制（这里是 linux-musl）。该站点在部分网络下不可达，
# 构建就报：
#   request to https://binaries.prisma.sh/.../libquery_engine.so.node.gz.sha256 failed
# 这是纯网络问题，与代码无关。
#
# PRISMA_ENGINES_MIRROR 指向可达的镜像即可。留空则用官方源。
# 国内可用：--build-arg PRISMA_ENGINES_MIRROR=https://cdn.npmmirror.com/binaries/prisma
ARG PRISMA_ENGINES_MIRROR=
ENV PRISMA_ENGINES_MIRROR=${PRISMA_ENGINES_MIRROR}
COPY . .
# 引擎缓存挂成 BuildKit cache：引擎有几十 MB，每次构建都重下既慢又依赖网络。
# Prisma 自己在缓存路径里带了 binaryTarget（linux-musl / linux-x64 等），
# 不同平台的二进制不会互相覆盖。
# --mount=type=cache 需要 BuildKit，compose 默认走 buildx，无需额外配置。
RUN --mount=type=cache,target=/root/.cache/prisma,sharing=locked \
    npx prisma generate --schema packages/db/prisma/schema.prisma

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    TZ=Asia/Shanghai

# worker 直接用 tsx 跑 TS 源码，省掉一层编译产物。
# 环境变量全部由 compose 注入，不在镜像里放 .env。
CMD ["npx", "tsx", "services/worker/src/index.ts"]
