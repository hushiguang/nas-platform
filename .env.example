# ============================================================
# 家庭 NAS 一体化平台 · 环境变量样例
# 复制成 .env 后按注释填写。各应用通过 @next/env 从仓库根加载，
# 生产由 docker-compose 注入同名变量。
# ============================================================

# ------------------------------------------------------------ 数据库
# Docker Compose 内部网络用 postgres 主机名；本地开发用 localhost
DATABASE_URL=postgresql://nas:CHANGE_ME@localhost:5432/nas_platform
PG_PASSWORD=CHANGE_ME
# PostgreSQL 数据目录在宿主机上的位置（bind mount）。
# 飞牛上指到存储卷，例如 /vol1/1000/nas-platform/pgdata；
# 留空则用仓库根目录下的 ./pgdata。
# 首次部署前记得：mkdir -p <该目录> && chown -R 70:70 <该目录>（70 是镜像里的 postgres uid）
PG_DATA_DIR=

# ------------------------------------------------------------ 域名（子域名方案）
# 填根域，不用带协议和端口。所有应用的地址、cookie 作用域都由它推导，
# 换域名只改这一处。**这是占位符，部署时改成你自己的域名**。
NAS_ROOT_DOMAIN=example.com
# 对外协议 / 端口：经外部反向代理（本方案用 Lucky）对外时这样填；
# 走 80/443 就把 NAS_PUBLIC_PORT 留空，URL 里就不带端口。
NAS_PUBLIC_PROTO=http
NAS_PUBLIC_PORT=:1443

# 各应用的子域前缀（默认依次是 nav / cash / todo / anniversary / work / pregnancy / travel）。
# 想换成别的（例如把纪念日换成 birthday）改这里，留空则用默认值。
PORTAL_SUBDOMAIN=
BILL_SUBDOMAIN=
TODO_SUBDOMAIN=
ANNIVERSARY_SUBDOMAIN=
WORK_SUBDOMAIN=
PREGNANCY_SUBDOMAIN=
TRAVEL_SUBDOMAIN=

# 前置条件：*.example.com 必须能解析到 NAS 的 IP。三条路径任选其一：
#   1. 内网 DNS（路由器 / AdGuard Home / dnsmasq）泛域名解析到 NAS
#   2. Tailscale MagicDNS + split DNS
#   3. 各子域在路由器上手工加 A 记录
# 解析不通时，浏览器根本不会带 cookie，表现为「在门户登录成功、跳到账单又掉线」。

# ------------------------------------------------------------ 认证
# 会话密钥：openssl rand -base64 32。**所有应用必须填同一个值**，
# 否则互相解不开对方的登录态，SSO 直接失效。
AUTH_SECRET=
# 自部署（非 Vercel）必须置 true，否则 Auth.js 报 UntrustedHost
AUTH_TRUST_HOST=true

# 跨子域 SSO 的 cookie 作用域，**由 NAS_ROOT_DOMAIN 自动推导成 .<root>**，
# 需要覆盖时才手工填。前面那个点不能省，否则 cookie 只对当前子域有效。
# 留空则降级为同域共享（同一域名不同端口也能用，cookie 不区分端口）。
AUTH_COOKIE_DOMAIN=
# 走 https 时置 true。内网 http 访问必须 false，否则浏览器不回传 cookie
AUTH_COOKIE_SECURE=false

# ------------------------------------------------------------ 各应用对外地址
# 门户用它渲染卡片链接，应用之间用它做跳转。
# 全部留空就行 —— docker-compose.yml 会按 NAS_ROOT_DOMAIN 拼出
# nav.<root>、cash.<root>……只有想改子域前缀时才手工填。
PORTAL_URL=
TODO_BASE_URL=
BILL_BASE_URL=
ANNIVERSARY_BASE_URL=
WORK_BASE_URL=
PREGNANCY_BASE_URL=
TRAVEL_BASE_URL=

# ------------------------------------------------------------ 跨应用内部调用
# 各应用不直读对方的表，汇总类数据走内部接口。这是那些接口的令牌。
# 没配置时内部接口一律拒绝访问（避免空令牌等于放行）。
# 生成：openssl rand -hex 24
SERVICE_TOKEN=

# 门户日志页读取 Docker 容器输出用的套接字。留空则依次尝试
# /var/run/docker.sock 和 ~/.docker/run/docker.sock。macOS 的 Docker Desktop 常用后者。
DOCKER_SOCKET=

# ------------------------------------------------------------ 定时任务
# /api/cron/[job] 手动补跑入口的密钥（worker 与各应用共用）
CRON_SECRET=

# ------------------------------------------------------------ 初始管理员
# 首次 seed 使用，登录后请立刻改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------ 通知渠道
# 企业微信应用消息：企微后台「我的企业 → 企业信息」拿 CorpID，
# 「应用管理 → 自建应用」拿 Secret 与 AgentId
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
# 企业微信群机器人 webhook（全地址或只填 key）。配了它就用群机器人，
# 不需要上面的应用三件套，也不受可信 IP / 可信域名限制，本地开发首选
WECOM_WEBHOOK=

# 邮件（SMTP）。465 端口默认隐式 TLS，其它端口走 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 内网/自签证书场景可设为 false
SMTP_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------ 图床
# EasyImages。账单票据、纪念日背景、待办图片共用这一套，token 只留在服务端。
# 不配则账单/纪念日不能上传；待办会自动退回本地目录（见 TODO_UPLOAD_DIR）。
# IMAGE_HOST_URL 填图床的上传地址；自签证书由服务端代理，浏览器不直连。
IMAGE_HOST_URL=
IMAGE_HOST_TOKEN=
# 回源白名单，逗号分隔。留空则只允许 IMAGE_HOST_URL 的主机
IMAGE_HOST_ALLOW_HOSTS=
IMAGE_PROXY_CACHE_TTL=86400
# 单张图片上限（字节），各应用共用
IMAGE_MAX_BYTES=12582912

# ------------------------------------------------------------ 待办本地图片目录
# 只在没用图床时生效：待办上传的图片存这里。
# 容器内路径，由 docker-compose 挂到 NAS 共享目录；本地开发留空即用仓库内 data/uploads/todo
TODO_UPLOAD_DIR=

# ------------------------------------------------------------ 其他
# 照片目录（容器内只读挂载路径），旅行相册用
# travel 容器里只读挂载飞牛相册目录（见 docker-compose travel 的 volumes），
# 应用只浏览/引用照片，从不复制文件、不写入
NAS_PHOTO_ROOT=/data/photos

# ------------------------------------------------------------ 高德地图（旅行足迹）
# AMAP_KEY：地图展示用的 Web端(JS API) Key
# AMAP_JSCODE：JS API 安全密钥，必填（不配会报 INVALID_USER_SCODE）
# AMAP_WEB_KEY：可选，只有用「按名称查坐标」时才需要（Web服务 Key）
AMAP_KEY=5c69834c6e0c5eb31112803f30ec998b
AMAP_JSCODE=
AMAP_WEB_KEY=

# 时区：web / worker / postgres 三处必须一致
TZ=Asia/Shanghai
