# ============================================================
# 家庭 NAS 一体化平台 · 环境变量样例
# 复制成 .env 后按注释填写。各应用通过 @next/env 从仓库根加载，
# 生产由 docker-compose 注入同名变量。
# ============================================================

# ------------------------------------------------------------ 数据根目录
# 所有容器的持久化数据都收在这个目录下，按应用分子目录：
#   <root>/pgdata    PostgreSQL 数据
#   <root>/bill      账单票据照片（容器内以 uid 1001 写入）
#   <root>/travel    旅行相册（只读挂载，把照片放这个目录）
#   <root>/todo      待办本地图片（没配图床时才用）
NAS_DATA_ROOT=/vol1/1000/docker/nas-platform

# ------------------------------------------------------------ 数据库
# Docker Compose 内部网络用 postgres 主机名；本地开发用 localhost
DATABASE_URL=postgresql://nas:CHANGE_ME@localhost:5432/nas_platform
PG_PASSWORD=CHANGE_ME
# ⚠ 首次部署前记得：mkdir -p <NAS_DATA_ROOT>/pgdata && chown -R 70:70 <NAS_DATA_ROOT>/pgdata
#   （70 是镜像里的 postgres uid，属主不对容器会因权限被拒）

# ------------------------------------------------------------ 域名（子域名方案）
# 填根域，不用带协议和端口。所有应用的地址、cookie 作用域都由它推导，
# 换域名只改这一处。**这是占位符，部署时改成你自己的域名**。
NAS_ROOT_DOMAIN=example.com
# 对外协议 / 端口：经外部反向代理（本方案用 Lucky）对外时这样填；
# 走 80/443 就把 NAS_PUBLIC_PORT 留空，URL 里就不带端口。
NAS_PUBLIC_PROTO=http
NAS_PUBLIC_PORT=:1443

# 各应用的子域前缀（默认依次是 nav / cash / todo / anniversary / work / pregnancy / travel）。
# 想换成别的（例如把纪念日换成 birthday）改这里，留空则用默认值。
PORTAL_SUBDOMAIN=
BILL_SUBDOMAIN=
TODO_SUBDOMAIN=
ANNIVERSARY_SUBDOMAIN=
WORK_SUBDOMAIN=
PREGNANCY_SUBDOMAIN=
TRAVEL_SUBDOMAIN=

# 前置条件：*.example.com 必须能解析到 NAS 的 IP。三条路径任选其一：
#   1. 内网 DNS（路由器 / AdGuard Home / dnsmasq）泛域名解析到 NAS
#   2. Tailscale MagicDNS + split DNS
#   3. 各子域在路由器上手工加 A 记录
# 解析不通时，浏览器根本不会带 cookie，表现为「在门户登录成功、跳到账单又掉线」。

# ------------------------------------------------------------ 认证
# 会话密钥：openssl rand -base64 32。**所有应用必须填同一个值**，
# 否则互相解不开对方的登录态，SSO 直接失效。
AUTH_SECRET=
# 自部署（非 Vercel）必须置 true，否则 Auth.js 报 UntrustedHost
AUTH_TRUST_HOST=true

# ⚠️ 默认不要出现这一行。
#
# 跨子域 SSO 的 cookie 作用域由 NAS_ROOT_DOMAIN 自动推导成 .<root>，
# compose 的写法是 ${AUTH_COOKIE_DOMAIN-.${NAS_ROOT_DOMAIN}} —— 变量「未设置」
# 才回退，所以只要这一行不写，门户登录一次，所有子域应用都认同一会话。
#
# 但如果写成 AUTH_COOKIE_DOMAIN= ，compose 会视为「已设置为空」并原样保留，
# 不套用默认值。cookie 因而不带 Domain，只对当前 host 生效 ——
# 症状就是「门户登录了，点进每个应用却都跳登录页」。看起来只差一个等号。
#
# 仅当改用 IP:端口 直连时才加回这一行并留空：
# 浏览器不接受 IP 主机上的 Domain cookie，硬填 .<root> 会导致 cookie 存不下、
# 登录报 MissingCSRF。但那种访问方式没有子域，也就不存在跨子域 SSO。
# 走 https 时置 true。内网 http 访问必须 false，否则浏览器不回传 cookie
AUTH_COOKIE_SECURE=false

# ------------------------------------------------------------ 各应用对外地址
# 门户用它渲染卡片链接，应用之间用它做跳转。
# 全部留空就行 —— docker-compose.yml 会按 NAS_ROOT_DOMAIN 拼出
# nav.<root>、cash.<root>……只有想改子域前缀时才手工填。
PORTAL_URL=
TODO_BASE_URL=
BILL_BASE_URL=
ANNIVERSARY_BASE_URL=
WORK_BASE_URL=
PREGNANCY_BASE_URL=
TRAVEL_BASE_URL=

# ------------------------------------------------------------ 跨应用内部调用
# 各应用不直读对方的表，汇总类数据走内部接口。这是那些接口的令牌。
# 没配置时内部接口一律拒绝访问（避免空令牌等于放行）。
# 生成：openssl rand -hex 24
SERVICE_TOKEN=
# 服务器之间调用用的地址由 docker-compose.yml 写死为容器名
# （TODO_INTERNAL_URL=http://nas-platform-todo:3000、
#  WORK_INTERNAL_URL=http://nas-platform-work:3000 …），并不需要在这里配。
# 注意用的是 Docker 内网 DNS：容器名和服务名都能解析，但**必须是同一张
# compose 网络里的容器**，不能填对外域名（见下面图床那条）。
# 本地开发不设这些变量，会退回上面的 *_BASE_URL（localhost:321x）。

# 门户日志页读取 Docker 容器输出用的套接字。留空则依次尝试
# /var/run/docker.sock 和 ~/.docker/run/docker.sock。macOS 的 Docker Desktop 常用后者。
DOCKER_SOCKET=

# ------------------------------------------------------------ 定时任务
# /api/cron/[job] 手动补跑入口的密钥（worker 与各应用共用）
CRON_SECRET=

# ------------------------------------------------------------ 初始管理员
# 首次 seed 使用，登录后请立刻改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------ 通知渠道
# 企业微信应用消息：企微后台「我的企业 → 企业信息」拿 CorpID，
# 「应用管理 → 自建应用」拿 Secret 与 AgentId
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=
# 企业微信群机器人 webhook（全地址或只填 key）。配了它就用群机器人，
# 不需要上面的应用三件套，也不受可信 IP / 可信域名限制，本地开发首选
WECOM_WEBHOOK=

# 邮件（SMTP）。465 端口默认隐式 TLS，其它端口走 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 内网/自签证书场景可设为 false
SMTP_REJECT_UNAUTHORIZED=true

# ------------------------------------------------------------ 图床
# EasyImages。账单票据、纪念日背景、待办图片共用这一套，token 只留在服务端。
# 不配则账单/纪念日不能上传；待办会自动退回本地目录（见 TODO_UPLOAD_DIR）。
# IMAGE_HOST_URL 填图床的上传地址；自签证书由服务端代理，浏览器不直连。
IMAGE_HOST_URL=
IMAGE_HOST_TOKEN=
# 服务端回源地址（可选，只换协议/主机/端口，路径不变）。
# 对外域名只有 AAAA 记录、NAS 的 Docker 没有 IPv6 时，容器回源会
# ENETUNREACH，表现为全站图片裂开（浏览器能开是因为手机/电脑有 IPv6）。
# 两种解法：
#   1. 给 image 子域补一条指向 NAS 局域网 IPv4 的 A 记录（推荐，不用改配置）
#   2. 在这里填容器能走通的 IPv4 地址，例如 https://192.168.1.10:1443
#      （上传和展示都会走它；白名单仍按 IMAGE_HOST_URL 的主机判断）
# ⚠ 不要填 http://127.0.0.1:端口 —— 容器里的 127.0.0.1 是容器自己，
#   不是 NAS 宿主机。要么走 Lucky 的局域网地址（如 https://<NAS_IP>:1443），
#   要么让 EasyImages 监听 0.0.0.0 后用 <NAS_IP>:15622，或直接使用容器名。
IMAGE_HOST_FETCH_BASE=
# 只把域名解析固定到 NAS 局域网 IPv4（推荐配合 Lucky 等按域名分流的反代）。
# URL 仍是 https://image.<root>:1443/...，Host/SNI 不变，只是连接打到 NAS 的
# IPv4，不会因反代按域名匹配而 404。和 IMAGE_HOST_FETCH_BASE 二选一。
# 例：IMAGE_HOST_FETCH_IP=192.168.0.36
IMAGE_HOST_FETCH_IP=
# 回源白名单，逗号分隔。留空则只允许 IMAGE_HOST_URL 的主机
IMAGE_HOST_ALLOW_HOSTS=
IMAGE_PROXY_CACHE_TTL=86400
# 单张图片上限（字节），各应用共用
IMAGE_MAX_BYTES=12582912

# ------------------------------------------------------------ 待办本地图片目录
# 只在没用图床时生效：待办上传的图片存这里。
# 容器内路径，由 docker-compose 挂到 NAS 共享目录；本地开发留空即用仓库内 data/uploads/todo
TODO_UPLOAD_DIR=

# ------------------------------------------------------------ 其他
# 照片目录（容器内只读挂载路径），旅行相册用
# travel 容器只读挂载 <NAS_DATA_ROOT>/travel（见 docker-compose travel 的 volumes），
# 应用只浏览/引用照片，从不复制文件、不写入
NAS_PHOTO_ROOT=/data/photos

# ------------------------------------------------------------ 高德地图（旅行足迹）
# AMAP_KEY：地图展示用的 Web端(JS API) Key
# AMAP_JSCODE：JS API 安全密钥，必填（不配会报 INVALID_USER_SCODE）
# AMAP_WEB_KEY：可选，只有用「按名称查坐标」时才需要（Web服务 Key）
AMAP_KEY=5c69834c6e0c5eb31112803f30ec998b
AMAP_JSCODE=
AMAP_WEB_KEY=

# 时区：web / worker / postgres 三处必须一致
TZ=Asia/Shanghai

# ------------------------------------------------------------ 构建期网络
# Prisma 的查询引擎（libquery_engine）不在 npm 包里，prisma generate 会联网从
# binaries.prisma.sh 下载与当前平台匹配的二进制（Alpine 上是 linux-musl）。
# 该站点在部分网络下不可达，构建会报：
#   request to https://binaries.prisma.sh/.../libquery_engine.so.node.gz.sha256 failed
# 这与代码无关，填一个可达的镜像即可。国内可用下面这个：
PRISMA_ENGINES_MIRROR=https://cdn.npmmirror.com/binaries/prisma
# 留空则用官方源（官方源可达时不用填）。
# 注意：这是**构建期**参数，只影响 docker build，不进容器运行时。
