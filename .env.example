# 数据库（Docker Compose 内部网络用 postgres 主机名；本地开发用 localhost）
DATABASE_URL=postgresql://nas:CHANGE_ME@localhost:5432/nas_platform
PG_PASSWORD=CHANGE_ME

# Auth.js 会话密钥：openssl rand -base64 32
AUTH_SECRET=
# 自部署（非 Vercel）必须置 true，否则 Auth.js 报 UntrustedHost
AUTH_TRUST_HOST=true

# 初始管理员（首次 seed 使用，之后改密码走页面）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# /api/cron/[job] 手动触发/补跑入口的密钥（worker 与 web 共用）
CRON_SECRET=

# NAS 照片目录（web 容器内只读挂载路径）
NAS_PHOTO_ROOT=/data/photos

# 通知渠道：企业微信应用消息（在企微后台「我的企业 → 企业信息」拿 CorpID，
# 在「应用管理 → 自建应用」拿 Secret 与 AgentId）
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_AGENT_ID=

# 通知渠道：邮件（SMTP）。465 端口默认隐式 TLS，其它端口走 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 内网/自签证书场景可设为 false
SMTP_REJECT_UNAUTHORIZED=true

# 时区三处统一（web / worker / postgres）
TZ=Asia/Shanghai
